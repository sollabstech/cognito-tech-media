# ---------------------------------------------------------------------------
# Cognito Tech Media — environment variables
# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Public site URL (used for metadata, canonical URLs, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://cognitotechmedia.com

# --- Google Business Profile reviews -----------------------------------------
# The site fetches REAL reviews from the Google Places API on the server and
# caches them (see src/lib/reviews.ts). Until both values below are set, the
# "What Our Clients Say" section renders a neutral fallback and NO rating/count
# is shown anywhere. Nothing is fabricated.
#
# 1. Create an API key in Google Cloud console with the "Places API (New)"
#    enabled, restricted to your server IP / referrers.
# 2. Find the Place ID for the Cognito Tech Media Google Business Profile:
#    https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PLACE_ID=

# How often (in seconds) the cached reviews may be refreshed. Default 21600 (6h).
GOOGLE_REVIEWS_REVALIDATE_SECONDS=21600
